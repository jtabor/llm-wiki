{
  "_comment": "Merge this fragment into ~/.claude/settings.json — do not replace the whole file.",
  "cleanupPeriodDays": 365,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/wiki-session-token.sh" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/wiki-archive-session.sh" }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "cat >> /tmp/subagent-probe.json" }
        ]
      }
    ]
  }
}
